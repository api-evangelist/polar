              "content": "List users exercises available in AccessLink. Only Exercises uploaded to Flow in the last 30 days are returned. Only exercises that have been uploaded to Flow after the user is registered with your client will be returned. Use samples and zones query parameters to return optional samples and zone information of the exercises.\nTraining Load Pro data will be included in the exercise object if the exercise is recorded with a specific wrist unit model,  please check [compatible devices](https://www.polar.com/en/smart-coaching/training-load-pro) for more information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "exercises"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "samples",
                  "value": "<boolean>",
                  "description": "Return all sample data for this exercise."
                },
                {
                  "disabled": false,
                  "key": "zones",
                  "value": "<boolean>",
                  "description": "Return all zones data for this exercise."
                },
                {
                  "disabled": false,
                  "key": "route",
                  "value": "<boolean>",
                  "description": "Return all route data for this exercise."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "accesslink.read_all"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://polarremote.com/v2/oauth2/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://flow.polar.com/oauth2/authorization"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
