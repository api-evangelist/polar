          "name": "Get Continuous Heart rate samples",
          "request": {
            "name": "Get Continuous Heart rate samples",
            "description": {
              "content": "Get users continuous heart rate values for given date. <a href=\"https://support.polar.com/en/support/the_what_and_how_of_polars_continuous_heart_rate\"> Supported devices </a>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "users",
                "continuous-heart-rate",
                ":date"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<date>",
                  "key": "date",
                  "description": "(Required) Date of Continuous Heart Rate as ISO-8601 date string, example: \"2022-01-01\""
                }
              ]
            },
            "header": [
